<?xml version="1.0" encoding="utf-8"?>
<!-- Desk send (post-chain output tap), 2026-10-22. Sent as AIDL cmd 10107,
     EXACTLY 7 floats: [0, enabled, mute local, gain dB, 0, 0, 0]; the native
     dispatch keys on the 28-byte block, the trailing zeros are padding. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup
        android:key="@string/key_desksend_enable"
        android:disableDependentsState="false"
        android:title="@string/desksend_enable"
        android:summary="@string/desksend_summary"
        android:icon="@drawable/ic_twotone_cast_24dp"
        app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            android:key="@string/key_desksend_mute_local"
            android:title="@string/desksend_mute_local"
            android:defaultValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_desksend_gain"
            android:title="@string/desksend_gain"
            android:defaultValue="0"
            app:minValue="-24"
            app:maxValue="12"
            app:unit="dB"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
    </me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup>
</PreferenceScreen>
