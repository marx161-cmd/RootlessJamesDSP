<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <!-- Output limiter on/off (2026-10-21). Default ON = stock behaviour; the
       limiter is the clip guard after post gain. Switching it off drops its
       ~5 ms lookahead in one step (one tick at the toggle). -->
  <me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup
      android:key="@string/key_limiter_enable"
      android:title="@string/output_limiter_enable"
      android:defaultValue="true"
      android:disableDependentsState="false"
      android:icon="@drawable/ic_twotone_volume_up_24dp" />
  <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
      android:key="@string/key_limiter_threshold"
      android:title="@string/output_limiter_threshold"
      android:defaultValue="-0.1"
      app:minValue="-60"
      app:maxValue="-0.1"
      app:unit="dB"
      app:allowDividerAbove="false"
      app:updatesContinuously="true"
      app:showSeekBarValue="true"
      app:iconSpaceReserved="false" />
  <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
      android:key="@string/key_limiter_attack"
      android:title="@string/output_limiter_attack"
      android:defaultValue="5"
      app:minValue="0.25"
      app:maxValue="20"
      app:unit="ms"
      app:allowDividerAbove="false"
      app:updatesContinuously="true"
      app:showSeekBarValue="true"
      app:iconSpaceReserved="false" />
  <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
      android:key="@string/key_limiter_release"
      android:title="@string/output_limiter_release"
      android:defaultValue="5"
      app:minValue="0.25"
      app:maxValue="20"
      app:unit="ms"
      app:allowDividerAbove="false"
      app:updatesContinuously="true"
      app:showSeekBarValue="true"
      app:iconSpaceReserved="false" />
  <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
      android:key="@string/key_limiter_knee"
      android:title="@string/output_limiter_knee"
      android:defaultValue="1.0"
      app:minValue="0.0"
      app:maxValue="1.0"
      app:allowDividerAbove="false"
      app:updatesContinuously="true"
      app:showSeekBarValue="true"
      app:iconSpaceReserved="false" />
  <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
      android:key="@string/key_output_postgain"
      android:title="@string/output_control_postgain"
      android:defaultValue="0"
      app:minValue="-15"
      app:maxValue="15"
      app:unit="dB"
      app:allowDividerAbove="false"
      app:updatesContinuously="true"
      app:showSeekBarValue="true"
      app:iconSpaceReserved="false" />
</PreferenceScreen>