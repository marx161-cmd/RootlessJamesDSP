<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup
        android:key="@string/key_compander_enable"
        android:disableDependentsState="false"
        android:title="@string/compander_enable"
        android:icon="@drawable/ic_baseline_arrow_collapse_24dp"
        app:iconSpaceReserved="false">
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_compander_threshold"
            android:title="@string/compander_threshold"
            android:defaultValue="-24"
            app:minValue="-60"
            app:maxValue="0"
            app:unit="dB"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_compander_ratio"
            android:title="@string/compander_ratio"
            android:defaultValue="4"
            app:minValue="1"
            app:maxValue="20"
            app:unit=":1"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_compander_knee"
            android:title="@string/compander_knee"
            android:defaultValue="1.0"
            app:minValue="0.063"
            app:maxValue="1.0"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_compander_attack"
            android:title="@string/compander_attack"
            android:defaultValue="5"
            app:minValue="0.1"
            app:maxValue="200"
            app:unit="ms"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_compander_release"
            android:title="@string/compander_release"
            android:defaultValue="100"
            app:minValue="1"
            app:maxValue="1000"
            app:unit="ms"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_compander_hold"
            android:title="@string/compander_hold"
            android:defaultValue="10"
            app:minValue="0"
            app:maxValue="500"
            app:unit="ms"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
    </me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup>
</PreferenceScreen>
