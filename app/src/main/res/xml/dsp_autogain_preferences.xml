<?xml version="1.0" encoding="utf-8"?>
<!-- LSP Autogain (stereo, internal sidechain, K-weighted BS.1770 loudness) --
     real plugin port, 2026-10-21; replaces the legacy RMS integrator. Sent as
     AIDL cmd 10104, 9 floats: [0, enabled, target LUFS, long period ms,
     short period ms, drift dB, silence LUFS, max gain dB, max gain on]. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup
        android:key="@string/key_autogain_enable"
        android:disableDependentsState="false"
        android:title="@string/autogain_enable"
        android:icon="@drawable/ic_baseline_arrow_collapse_24dp"
        app:iconSpaceReserved="false">
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_autogain_level"
            android:title="@string/autogain_level"
            android:defaultValue="-23"
            app:minValue="-60"
            app:maxValue="0"
            app:unit="LUFS"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_autogain_long_period"
            android:title="@string/autogain_long_period"
            android:defaultValue="400"
            app:minValue="100"
            app:maxValue="2000"
            app:unit="ms"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_autogain_short_period"
            android:title="@string/autogain_short_period"
            android:defaultValue="20"
            app:minValue="5"
            app:maxValue="100"
            app:unit="ms"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_autogain_drift"
            android:title="@string/autogain_drift"
            android:defaultValue="12"
            app:minValue="0"
            app:maxValue="24"
            app:unit="dB"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_autogain_silence"
            android:title="@string/autogain_silence"
            android:defaultValue="-72"
            app:minValue="-84"
            app:maxValue="-36"
            app:unit="LUFS"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <SwitchPreferenceCompat
            android:key="@string/key_autogain_max_gain_on"
            android:title="@string/autogain_max_gain_on"
            android:defaultValue="false"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_autogain_max_gain"
            android:title="@string/autogain_max_gain"
            android:defaultValue="36"
            app:minValue="0"
            app:maxValue="108"
            app:unit="dB"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
    </me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup>
</PreferenceScreen>
