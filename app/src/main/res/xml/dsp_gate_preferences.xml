<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup
        android:key="@string/key_gate_enable"
        android:disableDependentsState="false"
        android:title="@string/gate_enable"
        android:icon="@drawable/ic_baseline_arrow_collapse_24dp"
        app:iconSpaceReserved="false">
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_gate_open_threshold"
            android:title="@string/gate_open_threshold"
            android:defaultValue="-40"
            app:minValue="-80"
            app:maxValue="0"
            app:unit="dB"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_gate_close_threshold"
            android:title="@string/gate_close_threshold"
            android:defaultValue="-50"
            app:minValue="-80"
            app:maxValue="0"
            app:unit="dB"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_gate_attack"
            android:title="@string/gate_attack"
            android:defaultValue="1"
            app:minValue="0.1"
            app:maxValue="200"
            app:unit="ms"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_gate_release"
            android:title="@string/gate_release"
            android:defaultValue="50"
            app:minValue="1"
            app:maxValue="1000"
            app:unit="ms"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_gate_hold"
            android:title="@string/gate_hold"
            android:defaultValue="10"
            app:minValue="0"
            app:maxValue="500"
            app:unit="ms"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_gate_reduction"
            android:title="@string/gate_reduction"
            android:defaultValue="-60"
            app:minValue="-80"
            app:maxValue="0"
            app:unit="dB"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
    </me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup>
</PreferenceScreen>
