<?xml version="1.0" encoding="utf-8"?>
<!-- LSP Expander (stereo, internal sidechain) -- real plugin port, 2026-10-21.
     Sent as AIDL cmd 10103, 9 floats: [0, enabled, mode, threshold dB, ratio,
     knee (linear), attack ms, release ms, hold ms]. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup
        android:key="@string/key_expander_enable"
        android:disableDependentsState="false"
        android:title="@string/expander_enable"
        android:icon="@drawable/ic_baseline_keyboard_arrow_up_24dp"
        app:iconSpaceReserved="false">
        <ListPreference
            android:defaultValue="1"
            android:entries="@array/expander_mode_entries"
            android:entryValues="@array/expander_mode_values"
            android:title="@string/expander_mode"
            android:key="@string/key_expander_mode"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_expander_threshold"
            android:title="@string/expander_threshold"
            android:defaultValue="-12"
            app:minValue="-60"
            app:maxValue="0"
            app:unit="dB"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_expander_ratio"
            android:title="@string/expander_ratio"
            android:defaultValue="4"
            app:minValue="1"
            app:maxValue="20"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_expander_knee"
            android:title="@string/expander_knee"
            android:defaultValue="0.5"
            app:minValue="0.063"
            app:maxValue="1.0"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_expander_attack"
            android:title="@string/expander_attack"
            android:defaultValue="20"
            app:minValue="0.1"
            app:maxValue="2000"
            app:unit="ms"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_expander_release"
            android:title="@string/expander_release"
            android:defaultValue="100"
            app:minValue="1"
            app:maxValue="5000"
            app:unit="ms"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
        <me.timschneeberger.rootlessjamesdsp.preference.MaterialSeekbarPreference
            android:key="@string/key_expander_hold"
            android:title="@string/expander_hold"
            android:defaultValue="0"
            app:minValue="0"
            app:maxValue="1000"
            app:unit="ms"
            app:allowDividerAbove="false"
            app:updatesContinuously="true"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"/>
    </me.timschneeberger.rootlessjamesdsp.preference.SwitchPreferenceGroup>
</PreferenceScreen>
